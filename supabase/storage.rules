# Supabase Storage Rules for WebAR Menu
# Configure in Supabase Dashboard > Storage > Policies

# ============================================
# BUCKETS
# ============================================

-- Create buckets (run in SQL Editor)
-- INSERT INTO storage.buckets (id, name, public, file_size_limit, allowed_mime_types)
-- VALUES 
--   ('models', 'models', true, 52428800, ARRAY['model/gltf-binary', 'model/gltf+json', 'application/octet-stream']),
--   ('thumbnails', 'thumbnails', true, 5242880, ARRAY['image/jpeg', 'image/png', 'image/webp']),
--   ('markers', 'markers', true, 5242880, ARRAY['image/jpeg', 'image/png', 'image/webp']),
--   ('logos', 'logos', true, 5242880, ARRAY['image/jpeg', 'image/png', 'image/webp', 'image/svg+xml']);

# ============================================
# POLICIES FOR 'models' BUCKET (3D Models - GLB/GLTF)
# ============================================

-- Public read access for all models
CREATE POLICY "Public read models" ON storage.objects
    FOR SELECT USING (bucket_id = 'models');

-- Authenticated users can upload models
CREATE POLICY "Authenticated upload models" ON storage.objects
    FOR INSERT WITH CHECK (
        bucket_id = 'models' 
        AND auth.role() = 'authenticated'
        AND (storage.foldername(name))[1] = auth.uid()::text
    );

-- Users can update their own models
CREATE POLICY "Owner update models" ON storage.objects
    FOR UPDATE USING (
        bucket_id = 'models' 
        AND auth.uid()::text = (storage.foldername(name))[1]
    );

-- Users can delete their own models
CREATE POLICY "Owner delete models" ON storage.objects
    FOR DELETE USING (
        bucket_id = 'models' 
        AND auth.uid()::text = (storage.foldername(name))[1]
    );

-- Admin full access
CREATE POLICY "Admin full access models" ON storage.objects
    FOR ALL USING (
        bucket_id = 'models' 
        AND auth.jwt() ->> 'role' = 'admin'
    );

# ============================================
# POLICIES FOR 'thumbnails' BUCKET
# ============================================

CREATE POLICY "Public read thumbnails" ON storage.objects
    FOR SELECT USING (bucket_id = 'thumbnails');

CREATE POLICY "Authenticated upload thumbnails" ON storage.objects
    FOR INSERT WITH CHECK (
        bucket_id = 'thumbnails' 
        AND auth.role() = 'authenticated'
    );

CREATE POLICY "Admin full access thumbnails" ON storage.objects
    FOR ALL USING (
        bucket_id = 'thumbnails' 
        AND auth.jwt() ->> 'role' = 'admin'
    );

