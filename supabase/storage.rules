CREATE POLICY "Public read markers" ON storage.objects
    FOR SELECT USING (bucket_id = 'markers');

CREATE POLICY "Authenticated upload markers" ON storage.objects
    FOR INSERT WITH CHECK (
        bucket_id = 'markers' 
