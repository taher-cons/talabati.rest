# ============================================================
# WebAR Menu (طلباتي) — environment template
# Copy to .env and fill in real values:  cp .env.example .env
# Or generate automatically:             node scripts/rotate-env.mjs
#
# ⚠ NEVER commit a filled-in .env. Only this template belongs in git.
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3000

# --- Supabase (Dashboard → Settings → API Keys) ---
# Stack is Supabase/PostgreSQL. There is NO MongoDB in this project.
SUPABASE_URL=https://<your-project-ref>.supabase.co

# Use the NEW key format. Legacy anon/service_role JWT keys should be disabled.
#   publishable key -> safe for browsers  (sb_publishable_...)
#   secret key      -> SERVER ONLY, never ship to the client (sb_secret_...)
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Client / CORS ---
CLIENT_URL=http://localhost:5173
# Comma-separated list of additional allowed origins (production)
ALLOWED_ORIGINS=https://talabati.rest,https://www.talabati.rest

# --- Admin API protection ---
# Shared key required in the `x-admin-key` header for /api/*/admin/** and uploads.
# Generate with: node scripts/gen-secrets.mjs
ADMIN_API_KEY=

# --- App secrets (generate with: node scripts/gen-secrets.mjs) ---
JWT_SECRET=
SESSION_SECRET=

# --- File upload ---
UPLOAD_MAX_SIZE=52428800
UPLOAD_PATH=./public/uploads

# --- CDN ---
CDN_BASE_URL=

# --- Email (optional) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# --- Monitoring (optional) ---
GA_MEASUREMENT_ID=
SENTRY_DSN=
