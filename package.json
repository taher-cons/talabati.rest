{
  "name": "web-ar-menu",
  "version": "1.0.0",
  "description": "WebAR Menu Application - Restaurant Menu with Augmented Reality",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "build": "vite build",
    "dev:client": "vite",
    "preview": "vite preview",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local > types/supabase.ts",
    "secrets:rotate": "node scripts/rotate-env.mjs",
    "secrets:push": "node scripts/push-secrets.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "build:functions": "npm --prefix functions run build",
    "predeploy:firebase": "npm run build:functions",
    "deploy:firebase": "firebase deploy",
    "deploy:vercel": "vercel --prod"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.39.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/three": "^0.160.0",
    "gsap": "^3.12.0",
    "nodemon": "^3.0.2",
    "sharp": "^0.35.3",
    "three": "^0.160.0",
    "vite": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
